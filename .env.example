MONGODB_URI=mongodb://127.0.0.1:27017/userDB
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Optional: set both to enable Google sign-in.
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/secrets

# Production requires HTTPS. The app trusts one reverse proxy in production.
NODE_ENV=development
