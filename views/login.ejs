<%- include('partials/header') %>

<div class="container mt-5">
  <h1>Login</h1>

  <div class="row">
    <div class="col-sm-8">
      <div class="card">
        <div class="card-body">

          <!-- Makes POST request to /login route -->
          <form action="/login" method="POST">
            <div class="mb-3">
              <label class="form-label" for="email">Email</label>
              <input id="email" type="email" class="form-control" name="username" autocomplete="username" required>
            </div>
            <div class="mb-3">
              <label class="form-label" for="password">Password</label>
              <input id="password" type="password" class="form-control" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn btn-dark">Login</button>
          </form>

        </div>
      </div>
    </div>

    <% if (googleEnabled) { %>
    <div class="col-sm-4">
      <div class="card">
        <div class="card-body d-grid">
          <a class="btn btn-danger" href="/auth/google" role="button">
            <i class="fa-brands fa-google" aria-hidden="true"></i>
            Sign In with Google
          </a>
        </div>
      </div>
    </div>
    <% } %>

  </div>
</div>

<%- include('partials/footer') %>
