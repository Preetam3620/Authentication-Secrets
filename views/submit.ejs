<%- include('partials/header') %>

<div class="container">
  <div class="p-5 mb-4 bg-body-tertiary rounded-3 centered">
    <i class="fa-solid fa-key fa-6x" aria-hidden="true"></i>
    <h1 class="display-3">Secrets</h1>
    <p class="secret-text">Don't keep your secrets, share them anonymously!</p>

    <form action="/submit" method="POST">

      <div class="mb-3">
        <label class="visually-hidden" for="secret">Your secret</label>
        <input id="secret" type="text" class="form-control text-center" name="secret" placeholder="What's your secret?" required>
      </div>
      <button type="submit" class="btn btn-dark">Submit</button>
    </form>


  </div>
</div>
<%- include('partials/footer') %>
